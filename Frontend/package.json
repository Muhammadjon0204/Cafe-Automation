{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "admin-app",
    "kitchen-app",
    "waiter-app",
    "shared"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:admin": "npm run dev -w admin-app",
    "build:admin": "npm run build -w admin-app",
    "lint:admin": "npm run lint -w admin-app",
    "dev:kitchen": "npm run dev -w kitchen-app",
    "build:kitchen": "npm run build -w kitchen-app",
    "lint:kitchen": "npm run lint -w kitchen-app",
    "dev:waiter": "npm run dev -w waiter-app",
    "build:waiter": "npm run build -w waiter-app",
    "lint:waiter": "npm run lint -w waiter-app",
    "lint:all": "oxlint && npm run lint -w admin-app && npm run lint -w kitchen-app && npm run lint -w waiter-app"
  },
  "dependencies": {
    "@cafe/shared": "*",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
